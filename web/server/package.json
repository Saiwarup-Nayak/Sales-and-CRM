{
  "name": "pipeline-crm-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Express API for the Pipeline CRM (reads/writes data/crm_app.db; Python batch jobs supply model scores and the data review).",
  "main": "src/index.js",
  "engines": { "node": ">=22.13" },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/index.js",
    "dev": "node --disable-warning=ExperimentalWarning --watch src/index.js",
    "test": "node --disable-warning=ExperimentalWarning --test \"test/**/*.test.js\""
  },
  "dependencies": {
    "express": "^5.1.0"
  }
}
